# Every variable here is optional. The site builds and runs without a .env file:
# the contact form still validates and responds, it just logs instead of sending.
# Copy this file to .env.local to set them.

# Canonical origin, used for metadata, Open Graph, sitemap, and robots.
# Set this to the real domain before deploying, or social previews and the
# sitemap will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://akashagrawal.dev

# Contact form delivery via Resend (https://resend.com/api-keys).
# Without RESEND_API_KEY, submissions are validated and logged to the server
# console rather than emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_EMAIL=agrawal.akash@asu.edu
